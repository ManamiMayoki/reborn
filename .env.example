# Reborn Environment Configuration

# Server & Runtime
NODE_ENV=development
PORT=5000

# Database Connection (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/reborn

# Client URL (CORS)
CLIENT_URL=http://localhost:3000

# Computational Engine Specs
DOCKING_ENGINE=AutoDock Vina v1.2.5
FORCE_FIELD=Amber ff14SB / GAFF2
RANDOM_SEED=4242
